<?xml version="1.0"?>
<package format="3">
  <name>aubo_ompl_capture</name>
  <version>0.1.0</version>
  <description>Capture the exploration tree and paths from the same MoveIt OMPL planning request.</description>
  <maintainer email="zhuxd@todo.todo">zhuxd</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning</depend>
  <depend>moveit_planners_ompl</depend>
  <depend>moveit_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>std_msgs</depend>
  <depend>pluginlib</depend>
  <depend>ompl</depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

<?xml version="1.0"?>

<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>aubo_i5_scissors_description</name>

  <version>0.0.0</version>

  <description>
    AUBO i5 robot combined with an electric pruning scissor.
  </description>

  <maintainer email="zhuxd@todo.todo">
    zhuxd
  </maintainer>

  <license>Apache-2.0</license>

  <!-- Python启动文件需要 -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- 组合模型需要 -->
  <exec_depend>aubo_description</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>urdf</exec_depend>

  <!-- RViz显示需要 -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  
  <!-- RealSense D435i描述文件依赖 -->
  <depend>realsense2_description</depend>

  <!-- 测试依赖 -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>
<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="aubo_i5_scissors_robot">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import aubo_i5_scissors_robot urdf file -->
    <xacro:include filename="$(find aubo_i5_scissors_description)/urdf/robot_core.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="aubo_i5_scissors_robot.ros2_control.xacro" />


    <xacro:aubo_i5_scissors_robot_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>

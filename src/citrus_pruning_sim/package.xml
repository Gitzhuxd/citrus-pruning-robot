<?xml version="1.0"?>
<package format="3">
  <name>citrus_pruning_sim</name>
  <version>0.1.0</version>
  <description>Scan-informed citrus pruning state demonstration for ROS 2 Humble and RViz.</description>
  <maintainer email="maintainer@example.com">Citrus model workspace</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <!-- publish_moveit:=true (used by citrus_pruning_task/simulation.launch.py) needs these. -->
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>

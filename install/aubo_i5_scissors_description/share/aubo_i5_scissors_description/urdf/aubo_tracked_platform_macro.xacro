<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="tracked_platform_support" params="prefix label x y">
    <visual name="${prefix}${label}_post_visual">
      <origin xyz="${x} ${y} -0.0975" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="0.105"/></geometry>
      <material name="${prefix}platform_medium"/>
    </visual>
    <collision name="${prefix}${label}_post_collision">
      <origin xyz="${x} ${y} -0.0975" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="0.105"/></geometry>
    </collision>
    <visual name="${prefix}${label}_foot_visual">
      <origin xyz="${x} ${y} -0.1425" rpy="0 0 0"/>
      <geometry><box size="0.075 0.075 0.015"/></geometry>
      <material name="${prefix}platform_dark"/>
    </visual>
  </xacro:macro>

  <xacro:macro name="tracked_platform_hole_marker" params="prefix label x y radius">
    <visual name="${prefix}${label}_marker_visual">
      <origin xyz="${x} ${y} 0.001" rpy="0 0 0"/>
      <geometry><cylinder radius="${radius}" length="0.002"/></geometry>
      <material name="${prefix}hole_marker"/>
    </visual>
  </xacro:macro>

  <xacro:macro name="aubo_tracked_platform" params="prefix">
    <material name="${prefix}platform_dark">
      <color rgba="0.62 0.64 0.66 1"/>
    </material>
    <material name="${prefix}platform_medium">
      <color rgba="0.76 0.78 0.80 1"/>
    </material>
    <material name="${prefix}platform_light">
      <color rgba="0.66 0.68 0.70 1"/>
    </material>
    <material name="${prefix}chassis_silver">
      <color rgba="0.56 0.58 0.60 1"/>
    </material>
    <material name="${prefix}deck_silver">
      <color rgba="0.58 0.60 0.62 1"/>
    </material>
    <material name="${prefix}hole_marker">
      <color rgba="0.04 0.04 0.04 1"/>
    </material>

    <!-- Ground-projected root frame. -->
    <link name="${prefix}base_footprint"/>

    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="0 0 0.2125" rpy="0 0 0"/>
        <mass value="110.0"/>
        <inertia ixx="13.778645833" ixy="0" ixz="0"
                 iyy="7.522395833" iyz="0" izz="17.989583333"/>
      </inertial>

      <!-- Full detailed appearance. X=width, Y=length, Z=height. -->
      <visual name="${prefix}tracked_chassis_visual">
        <origin xyz="0 -0.00084939215938 0.00000005" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://aubo_i5_scissors_description/meshes/car/visual/hd2_base.dae"
                scale="6.59735485654382 6.42602632301544 8.63518906594074"/>
        </geometry>
      </visual>

      <!-- Raised vehicle body, z=0.330..0.430 m. -->
      <visual name="${prefix}raised_chassis_body_visual">
        <origin xyz="0 0 0.380" rpy="0 0 0"/>
        <geometry><box size="0.48 0.70 0.100"/></geometry>
        <material name="${prefix}chassis_silver"/>
      </visual>
      <collision name="${prefix}raised_chassis_body_collision">
        <origin xyz="0 0 0.380" rpy="0 0 0"/>
        <geometry><box size="0.48 0.70 0.100"/></geometry>
      </collision>

      <!-- Conservative planning collisions: two tracks plus central hull. -->
      <collision name="${prefix}left_track_collision">
        <origin xyz="0.32 0 0.2125" rpy="0 0 0"/>
        <geometry><box size="0.16 1.15 0.425"/></geometry>
      </collision>
      <collision name="${prefix}right_track_collision">
        <origin xyz="-0.32 0 0.2125" rpy="0 0 0"/>
        <geometry><box size="0.16 1.15 0.425"/></geometry>
      </collision>
      <collision name="${prefix}central_hull_collision">
        <origin xyz="0 0 0.265" rpy="0 0 0"/>
        <geometry><box size="0.48 0.92 0.32"/></geometry>
      </collision>
    </link>

    <joint name="${prefix}base_footprint_joint" type="fixed">
      <parent link="${prefix}base_footprint"/>
      <child link="${prefix}base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- Origin is the centre of the upper mounting surface at z=0.600 m. -->
    <link name="${prefix}arm_mount_link">
      <inertial>
        <origin xyz="0 0 -0.0858585623" rpy="0 0 0"/>
        <mass value="15.0"/>
        <inertia ixx="0.4924566300" ixy="0" ixz="0"
                 iyy="0.3432197500" iyz="0" izz="0.6932079600"/>
      </inertial>

      <visual name="${prefix}lower_platform_visual">
        <origin xyz="0 0 -0.160" rpy="0 0 0"/>
        <geometry><box size="0.50 0.72 0.020"/></geometry>
        <material name="${prefix}deck_silver"/>
      </visual>
      <collision name="${prefix}lower_platform_collision">
        <origin xyz="0 0 -0.160" rpy="0 0 0"/>
        <geometry><box size="0.50 0.72 0.020"/></geometry>
      </collision>

      <visual name="${prefix}upper_mounting_plate_visual">
        <origin xyz="0 0 -0.0225" rpy="0 0 0"/>
        <geometry><box size="0.42 0.52 0.045"/></geometry>
        <material name="${prefix}platform_light"/>
      </visual>
      <collision name="${prefix}upper_mounting_plate_collision">
        <origin xyz="0 0 -0.0225" rpy="0 0 0"/>
        <geometry><box size="0.42 0.52 0.045"/></geometry>
      </collision>

      <xacro:tracked_platform_support prefix="${prefix}" label="front_left"  x="0.17"  y="0.22"/>
      <xacro:tracked_platform_support prefix="${prefix}" label="front_right" x="0.17"  y="-0.22"/>
      <xacro:tracked_platform_support prefix="${prefix}" label="rear_left"   x="-0.17" y="0.22"/>
      <xacro:tracked_platform_support prefix="${prefix}" label="rear_right"  x="-0.17" y="-0.22"/>

      <!-- Provisional visual-only hole pattern. -->
      <xacro:tracked_platform_hole_marker prefix="${prefix}" label="centre" x="0" y="0" radius="0.020"/>
      <xacro:tracked_platform_hole_marker prefix="${prefix}" label="bolt_0" x="0.070" y="0" radius="0.007"/>
      <xacro:tracked_platform_hole_marker prefix="${prefix}" label="bolt_1" x="0.0495" y="0.0495" radius="0.007"/>
      <xacro:tracked_platform_hole_marker prefix="${prefix}" label="bolt_2" x="0" y="0.070" radius="0.007"/>
      <xacro:tracked_platform_hole_marker prefix="${prefix}" label="bolt_3" x="-0.0495" y="0.0495" radius="0.007"/>
      <xacro:tracked_platform_hole_marker prefix="${prefix}" label="bolt_4" x="-0.070" y="0" radius="0.007"/>
      <xacro:tracked_platform_hole_marker prefix="${prefix}" label="bolt_5" x="-0.0495" y="-0.0495" radius="0.007"/>
      <xacro:tracked_platform_hole_marker prefix="${prefix}" label="bolt_6" x="0" y="-0.070" radius="0.007"/>
      <xacro:tracked_platform_hole_marker prefix="${prefix}" label="bolt_7" x="0.0495" y="-0.0495" radius="0.007"/>
    </link>

    <joint name="${prefix}base_to_arm_mount" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}arm_mount_link"/>
      <origin xyz="0 0 0.600" rpy="0 0 0"/>
    </joint>

    <!-- Empty connection frame for an Aubo base link. -->
    <link name="${prefix}aubo_mount_frame"/>
    <joint name="${prefix}arm_mount_frame_joint" type="fixed">
      <parent link="${prefix}arm_mount_link"/>
      <child link="${prefix}aubo_mount_frame"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>

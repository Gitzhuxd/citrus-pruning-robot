0 0 0"/><geometry><mesh filename="package://aubo_i5_scissors_description/meshes/scissors/visual/part_007_solid_007.stl" scale="0.001 0.001 0.001"/></geometry><material name="scissor_dark"/></visual><!--  主体零件 008  --><visual><origin rpy="1.5707963 0 0" xyz="0 0 0"/><geometry><mesh filename="package://aubo_i5_scissors_description/meshes/scissors/visual/part_008_solid_008.stl" scale="0.001 0.001 0.001"/></geometry><material name="scissor_dark"/></visual><!--  主体零件 009  --><visual><origin rpy="1.5707963 0 0" xyz="0 0 0"/><geometry><mesh filename="package://aubo_i5_scissors_description/meshes/scissors/visual/part_009_solid_009.stl" scale="0.001 0.001 0.001"/></geometry><material name="scissor_dark"/></visual><!-- ================================================== --><!-- 剪刀主体碰撞模型                                   --><!-- 当前暂时沿用原始 STL，后期可改成简化碰撞模型        --><!-- ================================================== --><collision><origin rpy="1.5707963 0 0" xyz="0 0 0"/><geometry><mesh filename="package://aubo_i5_scissors_description/meshes/scissors/visual/part_003_solid_003.stl" scale="0.001 0.001 0.001"/></geometry></collision><collision><origin rpy="1.5707963 0 0" xyz="0 0 0"/><geometry><mesh filename="package://aubo_i5_scissors_description/meshes/scissors/visual/part_004_solid_004.stl" scale="0.001 0.001 0.001"/></geometry></collision><collision><origin rpy="1.5707963 0 0" xyz="0 0 0"/><geometry><mesh filename="package://aubo_i5_scissors_description/meshes/scissors/visual/part_005_solid_005.stl" scale="0.001 0.001 0.001"/></geometry></collision><collision><origin rpy="1.5707963 0 0" xyz="0 0 0"/><geometry><mesh filename="package://aubo_i5_scissors_description/meshes/scissors/visual/part_006_solid_006.stl" scale="0.001 0.001 0.001"/></geometry></collision><collision><origin rpy="1.5707963 0 0" xyz="0 0 0"/><geometry><mesh filename="package://aubo_i5_scissors_description/meshes/scissors/visual/part_007_solid_007.stl" scale="0.001 0.001 0.001"/></geometry></collision><collision><origin rpy="1.5707963 0 0" xyz="0 0 0"/><geometry><mesh filename="package://aubo_i5_scissors_description/meshes/scissors/visual/part_008_solid_008.stl" scale="0.001 0.001 0.001"/></geometry></collision><collision><origin rpy="1.5707963 0 0" xyz="0 0 0"/><geometry><mesh filename="package://aubo_i5_scissors_description/meshes/scissors/visual/part_009_solid_009.stl" scale="0.001 0.001 0.001"/></geometry></collision></link><!-- ====================================================== --><!-- 3. 主动刀片 Link                                     --><!-- ====================================================== --><link name="scissor_active_blade_link"><inertial><origin rpy="0 0 0" xyz="0.0070499998 0.014964871 0.030601738"/><mass value="0.02"/><inertia ixx="1.9663629e-05" ixy="0" ixz="0" iyy="1.3739718e-05" iyz="0" izz="6.5866103e-06"/></inertial><!-- 主动刀片显示模型 --><visual><origin rpy="1.5707963 0 0" xyz="-0.0008 -0.092997894 2.05725e-06"/><geometry><mesh filename="package://aubo_i5_scissors_description/meshes/scissors/visual/part_002_solid_002.stl" scale="0.001 0.001 0.001"/></geometry><material name="scissor_metal"/></visual><!-- 主动刀片碰撞模型 --><collision><origin rpy="1.5707963 0 0" xyz="-0.0008 -0.092997894 2.05725e-06"/><geometry><mesh filename="package://aubo_i5_scissors_description/meshes/scissors/visual/part_002_solid_002.stl" scale="0.001 0.001 0.001"/></geometry></collision></link><!-- ====================================================== --><!-- 4. 从动刀片 Link                                     --><!-- ====================================================== --><link name="scissor_mimic_blade_link"><inertial><origin rpy="0 0 0" xyz="-0.0064 0.019301949 -0.026402763"/><mass value="0.02"/><inertia ixx="1.5965507e-05" ixy="0" ixz="0" iyy="9.8868516e-06" iyz="0" izz="6.6247887e-06"/></inertial><!-- 从动刀片显示模型 --><visual><origin rpy="1.5707963 0 0" xyz="-0.0008 -0.092997894 2.05725e-06"/><geometry><mesh filename="package://aubo_i5_scissors_description/meshes/scissors/visual/part_001_solid_001.stl" scale="0.001 0.001 0.001"/></geometry><material name="scissor_metal"/></visual><!-- 从动刀片碰撞模型 --><collision><origin rpy="1.5707963 0 0" xyz="-0.0008 -0.092997894 2.05725e-06"/><geometry><mesh filename="package://aubo_i5_scissors_description/meshes/scissors/visual/part_001_solid_001.stl" scale="0.001 0.001 0.001"/></geometry></collision></link><!-- ====================================================== --><!-- 5. 主动刀片旋转关节                                  --><!-- ====================================================== --><joint name="scissor_drive_joint" type="revolute"><!-- 刀片转轴相对于剪刀主体的位置 --><origin rpy="0 0 0" xyz="0.0008 0.092997894 -2.05725e-06"/><parent link="scissor_base_link"/><child link="scissor_active_blade_link"/><!-- 刀片绕局部 X 轴负方向转动 --><axis xyz="-1 0 0"/><!--
      lower / upper：允许的旋转角度，单位为弧度
      effort：最大关节驱动力矩，当前为估计值
      velocity：最大关节速度，当前为估计值
    --><limit effort="10" lower="0.26" upper="1.0" velocity="5"/></joint><!-- ====================================================== --><!-- 6. 从动刀片 Mimic 关节                               --><!-- ====================================================== --><joint name="scissor_mimic_joint" type="revolute"><origin rpy="0 0 0" xyz="0.0008 0.092997894 -2.05725e-06"/><parent link="scissor_base_link"/><child link="scissor_mimic_blade_link"/><axis xyz="-1 0 0"/><!--
      multiplier="-1"：
      从动刀片与主动刀片以相反方向旋转。

      offset="0"：
      两个刀片之间没有额外角度偏移。
    --><mimic joint="scissor_drive_joint" multiplier="-1" offset="0"/><limit effort="10" lower="-1.0" upper="-0.26" velocity="5.0"/></joint><!-- ====================================================== --><!-- 7. 剪切工具中心点 TCP                                --><!-- ====================================================== --><!--
    scissor_tcp 是后续 MoveIt 规划所使用的剪切工具坐标系。

    当前 xyz 和 rpy 均为临时零值，不能作为最终剪切点使用。

    后续需要测量：
      1. scissor_base_link 原点到两刀片有效剪切区域的距离；
      2. 剪刀接近枝条时的工具朝向；
      3. 刀片闭合位置对应的真实剪切中心。
  --><link name="scissor_tcp"/><joint name="scissor_tcp_joint" type="fixed"><!-- 后续根据真实测量结果修改 --><origin rpy="-1.5708 0 0" xyz="0 0.15 0.005"/><parent link="scissor_base_link"/><child link="scissor_tcp"/></joint><!-- ====================================================== --><!-- 3. 将剪刀安装到AUBO末端 --><!-- ====================================================== --><joint name="scissor_mount_joint" type="fixed"><!-- 转接板的连接坐标系 --><parent link="zhuanjie_link"/><!-- 剪刀URDF的根连杆 --><child link="scissor_base_link"/><!-- 先用零位姿验证连接，后续根据转接板调整 --><origin rpy="0 -1.57079632679 0" xyz="0 0 -0.1"/></joint><!-- ====================================================== --><!-- 4. 导入RealSense D435i模型 --><!-- ====================================================== --><material name="aluminum"><color rgba="0.5 0.5 0.5 1"/></material><material name="plastic"><color rgba="0.1 0.1 0.1 1"/></material><!-- ====================================================== --><!-- 5. 将D435i安装到转接板 --><!-- ====================================================== --><!-- camera body, with origin at bottom screw mount --><joint name="camera_joint" type="fixed"><origin rpy="0 0 1.57079632679" xyz="0 0.01 -0.04"/><parent link="zhuanjie_link"/><child link="camera_bottom_screw_frame"/></joint><link name="camera_bottom_screw_frame"/><joint name="camera_link_joint" type="fixed"><origin rpy="0 0 0" xyz="0.010600000000000002 0.0175 0.0125"/><parent link="camera_bottom_screw_frame"/><child link="camera_link"/></joint><link name="camera_link"><visual><!-- the mesh origin is at front plate in between the two infrared camera axes --><origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0.0043 -0.0175 0"/><geometry><mesh filename="package://realsense2_description/meshes/d435.dae"/></geometry></visual><collision><origin rpy="0 0 0" xyz="0 -0.0175 0"/><geometry><box size="0.02505 0.09 0.025"/></geometry></collision><inertial><!-- The following are not reliable values, and should not be used for modeling --><mass value="0.072"/><origin xyz="0 0 0"/><inertia ixx="0.003881243" ixy="0.0" ixz="0.0" iyy="0.000498940" iyz="0.0" izz="0.003879257"/></inertial></link><!-- camera depth joints and links --><joint name="camera_depth_joint" type="fixed"><origin rpy="0 0 0" xyz="0 0 0"/><parent link="camera_link"/><child link="camera_depth_frame"/></joint><link name="camera_depth_frame"/><joint name="camera_depth_optical_joint" type="fixed"><origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/><parent link="camera_depth_frame"/><child link="camera_depth_optical_frame"/></joint><link name="camera_depth_optical_frame"/><!-- camera left IR joints and links --><joint name="camera_infra1_joint" type="fixed"><origin rpy="0 0 0" xyz="0 0.0 0"/><parent link="camera_link"/><child link="camera_infra1_frame"/></joint><link name="camera_infra1_frame"/><joint name="camera_infra1_optical_joint" type="fixed"><origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/><parent link="camera_infra1_frame"/><child link="camera_infra1_optical_frame"/></joint><link name="camera_infra1_optical_frame"/><!-- camera right IR joints and links --><joint name="camera_infra2_joint" type="fixed"><origin rpy="0 0 0" xyz="0 -0.05 0"/><parent link="camera_link"/><child link="camera_infra2_frame"/></joint><link name="camera_infra2_frame"/><joint name="camera_infra2_optical_joint" type="fixed"><origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/><parent link="camera_infra2_frame"/><child link="camera_infra2_optical_frame"/></joint><link name="camera_infra2_optical_frame"/><!-- camera color joints and links --><joint name="camera_color_joint" type="fixed"><origin rpy="0 0 0" xyz="0 0.015 0"/><parent link="camera_link"/><child link="camera_color_frame"/></joint><link name="camera_color_frame"/><joint name="camera_color_optical_joint" type="fixed"><origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/><parent link="camera_color_frame"/><child link="camera_color_optical_frame"/></joint><link name="camera_color_optical_frame"/><link name="camera_accel_frame"/><link name="camera_accel_optical_frame"/><link name="camera_gyro_frame"/><link name="camera_gyro_optical_frame"/><joint name="camera_accel_joint" type="fixed"><origin rpy="0 0 0" xyz="-0.01174 -0.00552 0.0051"/><parent link="camera_link"/><child link="camera_accel_frame"/></joint><joint name="camera_accel_optical_joint" type="fixed"><origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/><parent link="camera_accel_frame"/><child link="camera_accel_optical_frame"/></joint><joint name="camera_gyro_joint" type="fixed"><origin rpy="0 0 0" xyz="-0.01174 -0.00552 0.0051"/><parent link="camera_link"/><child link="camera_gyro_frame"/></joint><joint name="camera_gyro_optical_joint" type="fixed"><origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/><parent link="camera_gyro_frame"/><child link="camera_gyro_optical_frame"/></joint><ros2_control name="FakeSystem" type="system"><hardware><!-- By default, set up controllers for simulation. This won't work on real hardware --><plugin>mock_components/GenericSystem</plugin></hardware><joint name="shoulder_joint"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0</param></state_interface><state_interface name="velocity"/></joint><joint name="upperArm_joint"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0</param></state_interface><state_interface name="velocity"/></joint><joint name="foreArm_joint"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0</param></state_interface><state_interface name="velocity"/></joint><joint name="wrist1_joint"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0</param></state_interface><state_interface name="velocity"/></joint><joint name="wrist2_joint"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0</param></state_interface><state_interface name="velocity"/></joint><joint name="wrist3_joint"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0</param></state_interface><state_interface name="velocity"/></joint><joint name="scissor_drive_joint"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.3</param></state_interface><state_interface name="velocity"/></joint></ros2_control></robot>